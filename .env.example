# Copiez ce fichier en .env (production/staging) ou .env.local (tests locaux,
# automatiquement ignoré par Vite et par .gitignore via `*.local`).
#
# /!\ NE JAMAIS committer .env ni .env.local : ils contiennent des secrets.
#     Pour tes propres tests locaux, utilise .env.local (gitignored).

# --- Supabase (obligatoire) ---------------------------------------------------
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Drapeaux d'intégration Edge ----------------------------------------------

# Authentification via Edge Function (user-service.ts).
# true  : la création de l'utilisateur passe par l'Edge Function `verify-otp`
#         (l'utilisateur est créé côté serveur) — chemin sécurisé recommandé
#         en production, une fois les policies anon verrouillées.
# false : (défaut) insert client direct dans `wifi_users` — démo/staging uniquement.
# Valeur attendue en prod : true
VITE_USE_EDGE_AUTH=false

# Autorisation de session via Edge Function `authorize-guest` (session-service.ts).
# /!\ NE PAS ACTIVER : le contrat sécurisé de `authorize-guest` n'est pas encore
#     validé (ni authentification ni vérification de paiement — AUDIT-BACKEND C,
#     RAPPORT-PORTAIL §6.2). Le service reste délibérément désactivé
#     (createSession/updateSession/deactivateSession renvoient null/false).
#     Ce drapeau est présente pour la traçabilité, il DOIT rester à false.
VITE_USE_EDGE_SESSION=false

# --- E2E (Playwright) ----------------------------------------------------------
# Cible des tests e2e. Non défini (défaut) = preview local (vite preview :4173),
# déterministe et sans aucune écriture en base live.
# `E2E_TARGET=vercel` = staging/production, exécution MANUELLE uniquement
# (npm run e2e:staging) — jamais en CI (le parcours démo écrit en base).
E2E_TARGET=
